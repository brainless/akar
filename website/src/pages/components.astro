---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/common/Header.astro';
import Footer from '@/components/common/Footer.astro';
import Container from '@/components/ui/Container.astro';
import GlassCard from '@/components/ui/GlassCard.astro';
import Badge from '@/components/ui/Badge.astro';
import Section from '@/components/ui/Section.astro';
import { categories, implementedByCategory } from '@/lib/components';
import { plannedComponents, referenceSources } from '@/lib/component-crosswalk';

const planned = plannedComponents();
---

<BaseLayout
  title="Components - akar"
  description="33 GPU-accelerated UI components with C ABI bindings"
>
  <Header />

  <main id="main" tabindex="-1" class="main-content">
    <section class="components-hero">
      <Container size="xl">
        <div class="hero-content">
          <h1 class="hero-title">Components</h1>
          <p class="hero-description">
            33 implemented component families. Targeting parity with shadcn/ui and daisyUI.
          </p>
        </div>
      </Container>
    </section>

    {categories.map((category) => {
      const items = implementedByCategory(category);
      if (items.length === 0) return null;
      return (
        <Section
          eyebrow={category}
          container="xl"
        >
          <div class="components-grid">
            {items.map((component) => (
              <GlassCard padding="none" radius="lg" class="component-card">
                <div class="component-preview">
                  <img
                    src={`/screenshots/components/${component.screenshot}`}
                    alt={`${component.name} showcase`}
                    class="component-image"
                    loading="lazy"
                  />
                </div>
                <div class="component-info">
                  <div class="component-header">
                    <h3 class="component-name">{component.name}</h3>
                    <div class="component-badges">
                      <Badge variant="success" size="sm">Implemented</Badge>
                      {!component.cAbi && (
                        <Badge variant="neutral" size="sm">Rust only</Badge>
                      )}
                    </div>
                  </div>
                  <p class="component-description">{component.description}</p>
                  {component.variants.length > 0 && (
                    <div class="component-variants">
                      {component.variants.map((v) => (
                        <span class="variant-tag">{v}</span>
                      ))}
                    </div>
                  )}
                </div>
              </GlassCard>
            ))}
          </div>
        </Section>
      );
    })}

    <Section
      eyebrow="Roadmap"
      title="Coming next."
      subtitle="Components planned for future releases, derived from daisyUI and shadcn/ui parity analysis."
      container="xl"
    >
      <div class="components-grid">
        {planned.map((entry) => (
          <GlassCard padding="lg" radius="lg" class="component-card component-card--compact">
            <div class="component-header">
              <h3 class="component-name">{entry.name}</h3>
              <div class="component-badges">
                <Badge variant="neutral" size="sm">Planned</Badge>
                <Badge variant="neutral" size="sm">{entry.source}</Badge>
              </div>
            </div>
            <p class="component-description">{entry.reason}</p>
          </GlassCard>
        ))}
      </div>
      <p class="crosswalk-note">
        Crosswalk compared against local checkouts pinned at{' '}
        {referenceSources.map((source, i) => (
          <>
            {i > 0 && ' and '}
            {source.label} <code>{source.pinnedCommit.slice(0, 12)}</code>
          </>
        ))}.
      </p>
    </Section>

    <section class="components-cta">
      <Container size="xl">
        <GlassCard padding="xl" radius="lg">
          <h2>Contributing</h2>
          <p>
            akar is open source. Contributions are welcome -- whether it's implementing
            a planned component, fixing a bug, or improving documentation.
          </p>
          <div class="cta-actions">
            <a
              href="https://github.com/brainless/akar"
              class="cta-link"
              target="_blank"
              rel="noopener noreferrer"
            >
              View on GitHub
              <span aria-hidden="true">↗</span>
            </a>
          </div>
        </GlassCard>
      </Container>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .main-content {
    min-height: 100vh;
    min-height: 100dvh;
  }

  .components-hero {
    padding-top: clamp(5rem, 12vw, 10rem);
    padding-bottom: clamp(3rem, 8vw, 6rem);
  }

  .hero-content {
    text-align: center;
    max-width: 48rem;
    margin: 0 auto;
  }

  .hero-title {
    font-size: clamp(3rem, 8vw, 6rem);
    font-weight: 800;
    line-height: 0.9;
    letter-spacing: -0.06em;
    margin-bottom: var(--space-lg);
  }

  .hero-description {
    font-size: var(--text-xl);
    color: var(--color-text-muted);
    line-height: 1.6;
    margin: 0;
  }

  .components-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: var(--space-lg);
  }

  .component-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .component-card--compact {
    overflow: visible;
  }

  .component-preview {
    background: var(--glass-bg);
    padding: var(--space-md);
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 120px;
  }

  .component-image {
    display: block;
    max-width: 100%;
    height: auto;
    max-height: 240px;
    object-fit: contain;
  }

  .component-info {
    padding: var(--space-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .component-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
  }

  .component-badges {
    display: flex;
    gap: var(--space-xs);
    flex-shrink: 0;
  }

  .component-name {
    font-size: var(--text-lg);
    font-weight: 700;
    margin: 0;
  }

  .component-description {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: 1.5;
    margin: 0;
  }

  .component-variants {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-top: var(--space-xs);
  }

  .variant-tag {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    background: var(--glass-bg);
    padding: 0.125rem 0.5rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--glass-border);
  }

  .crosswalk-note {
    margin-top: var(--space-lg);
    color: var(--color-text-muted);
    font-size: var(--text-xs);
  }

  .crosswalk-note code {
    font-family: var(--font-mono, monospace);
  }

  .components-cta {
    padding-block: clamp(4rem, 10vw, 8rem);
  }

  .components-cta h2 {
    font-size: var(--text-3xl);
    font-weight: 700;
    margin-bottom: var(--space-md);
  }

  .components-cta p {
    color: var(--color-text-muted);
    line-height: 1.6;
    margin-bottom: var(--space-xl);
    max-width: 40rem;
  }

  .cta-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    color: var(--color-accent-text);
    font-weight: 600;
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .cta-link:hover {
    color: var(--color-accent);
  }

  @media (max-width: 768px) {
    .components-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
